{
  "name": "p2p-messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "tauri": "tauri",
    "lint": "oxlint",
    "preview": "vite preview",
    "phone": "node scripts/phone.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "vitest run && node tests/e2e/run.mjs && node tests/e2e/ui.mjs",
    "test:ui": "node tests/e2e/ui.mjs",
    "cap:sync": "vite build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "mock:server": "node tests/mock/serve.mjs",
    "test:mock": "node tests/mock/run.mjs",
    "test:mock-ui": "node tests/e2e/ui-shortcode.mjs",
    "mobile:sync": "node scripts/mobile/sync-overlays.mjs",
    "mobile:check": "node scripts/mobile/check.mjs",
    "test:mobile": "vitest run tests/mobile tests/platform.test.ts tests/platform",
    "test:mobile-emu": "node tests/mobile/emulation.mjs",
    "test:call": "node tests/e2e/call.mjs",
    "test:call-unit": "vitest run tests/call",
    "test:chat": "node tests/e2e/chat-features.mjs",
    "test:i18n": "node tests/e2e/i18n-en.mjs",
    "test:extension-browser": "node tests/extension/browser.mjs",
    "extension:pack": "node scripts/extension/pack.mjs",
    "test:a11y": "node tests/e2e/a11y.mjs",
    "test:a11y:dark": "A11Y_SCHEME=dark node tests/e2e/a11y.mjs",
    "test:crypto-suite": "node tests/e2e/crypto-suite.mjs",
    "test:demo": "node tests/e2e/demo-signaling.mjs",
    "test:pages": "node tests/e2e/pages-smoke.mjs",
    "test:files": "node tests/e2e/files.mjs",
    "build:linux": "npm run build:desktop && npm --prefix electron ci && npm --prefix electron run dist",
    "test:linux": "node tests/desktop/electron-linux.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/ibm-plex-sans": "5.2.5",
    "@fontsource/ibm-plex-serif": "5.2.5",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "4.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
