// Cloudflare Worker config for the Telegram signaling relay.
// Storage: one KV namespace that holds pending deliveries (token -> chat and message
// ids), removed when the recipient clicks the button or when due, and short-code
// invitations (code -> signed invitation, 10 minutes, deleted on first fetch).
// Create it once: npx wrangler kv namespace create DELIVERIES
// and paste the printed id below.
// Secrets (set with wrangler secret put, never committed):
//   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
{
  "name": "p2p-telegram-signal",
  "main": "index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  // Privacy choice: Workers Logs and invocation logs are OFF. With them on, Cloudflare would
  // store every request URL for days, and the URL carries invitation and room codes
  // (/invite/:code, /ws/rooms/:code). No logpush or tail consumers are configured, and the
  // code has no console.* calls. Do not turn this on without updating SECURITY.md.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
  },
  "routes": [
    { "pattern": "tg.dyrakarmy.online", "custom_domain": true },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Per client IP: at most 30 invitation requests per minute (POST /invite and GET /invite/:code).
  // Cloudflare Rate Limiting binding; namespace_id is any unique number within the account.
  "ratelimits": [
    { "name": "INVITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  // Demo WebSocket signaling: one SignalRoom Durable Object per room code (see worker/room.ts).
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL_ROOM", "class_name": "SignalRoom" }],
  },
  // new_sqlite_classes: the only Durable Object kind on the Workers free plan (error 10097 otherwise).
  // SignalRoom keeps its rooms in memory and uses alarms; both work on SQLite-backed objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "kv_namespaces": [
    { "binding": "DELIVERIES", "id": "735f0036ab7a449f8935c147f5a0a28a" },
  ],
}
