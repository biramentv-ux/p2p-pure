{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P Messenger",
  "version": "0.8.1",
  "identifier": "bg.p2pmessenger.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P2P Messenger",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DyrakArmy",
    "shortDescription": "Encrypted peer-to-peer messenger",
    "longDescription": "End-to-end encrypted peer-to-peer messenger. Messages, calls and history stay on the devices; no account, no phone number.",
    "category": "SocialNetworking",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Bulgarian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
